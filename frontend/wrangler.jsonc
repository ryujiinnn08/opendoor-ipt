// Cloudflare Workers static assets deploy for the React SPA (plan §5.6).
// Workers Builds runs `npm run build` and then `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opendoor",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve index.html for client-side routes such as /candidate/dashboard.
    "not_found_handling": "single-page-application"
  }
}
