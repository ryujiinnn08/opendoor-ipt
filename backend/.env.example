APP_NAME=OpenDoor
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opendoor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (EMAIL_VERIFICATION_PLAN). Locally, "log" writes each email, with its link, to
# storage/logs/laravel.log. Production uses "resend" (Resend's HTTP API).
MAIL_MAILER=log
# Resend API key with sending access only; set in Railway, never committed.
RESEND_API_KEY=
# The sender; its domain must be verified in Resend (production: no-reply@ruzgal.org).
MAIL_FROM_ADDRESS="no-reply@example.com"
# The sender name people see in their inbox.
MAIL_FROM_NAME="${APP_NAME}"
# The team inbox for the "Contact us" form (a real mailbox you read). Empty = the form answers 503.
CONTACT_TO_EMAIL=contact-opendoor@ruzgal.org
# Only for MAIL_MAILER=smtp.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seeded accounts (php artisan db:seed). Leave blank on local computers to use the
# defaults: admin@opendoor.test, candidate@opendoor.test, employer@opendoor.test
# with password OpenDoor@2026. Production requires the admin values; demo accounts
# are created in production only when SEED_DEMO_PASSWORD is set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Days after the hire date before a hired job seeker can rate the accommodations (plan PHASE_5 §2).
FEEDBACK_DELAY_DAYS=30
